# ==============================================================================
# UNICRIA ANA — VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ==============================================================================

# AMBIENTE & DOMÍNIO
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# BANCO DE DADOS (PostgreSQL obrigatório para produção)
# Para desenvolvimento local, utilize PostgreSQL (ex: Docker ou Neon/Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/unicria_db?schema=public"

# AUTENTICAÇÃO E SESSÕES (Gere chaves seguras com: openssl rand -hex 32)
AUTH_SECRET="gere-um-segredo-aleatorio-com-32-ou-mais-bytes"

# POLÍTICA DE SIMULAÇÃO (defina 'false' para forçar comportamento 100% real de produção)
ALLOW_SIMULATED_FALLBACK=false

# IA — OPENAI (Obrigatório em produção)
OPENAI_API_KEY="sk-proj-sua-chave-openai-aqui"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# WHATSAPP CLOUD API (Meta for Developers)
WHATSAPP_PROVIDER="cloud_api"
WHATSAPP_APP_SECRET="app-secret-fornecido-pela-meta"
WHATSAPP_VERIFY_TOKEN="token-aleatorio-para-validar-webhook-meta"
WHATSAPP_PHONE_ID="id-numerico-do-telefone-na-meta"
WHATSAPP_TOKEN="token-permanente-de-acesso-system-user"

# UAZAPI (Opcional - apenas se WHATSAPP_PROVIDER=uazapi)
UAZAPI_URL=""

# KIKOLO ONLINE (Agendamento Automático via Playwright)
KIKOLO_URL="https://app.kikolo.com/login"
KIKOLO_EMAIL="conta-de-servico@unicria.ao"
KIKOLO_PASSWORD="senha-forte-da-conta-kikolo"

# MONITORAMENTO & LOGS (Opcional)
SENTRY_DSN=""
LOG_LEVEL="info"
